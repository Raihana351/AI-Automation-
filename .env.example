# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# AWS Serverless & Cloud Infrastructure
# Provide your AWS API Gateway endpoint or CloudFront proxy URL
VITE_AWS_API_GATEWAY_URL="https://your-api-id.execute-api.us-east-1.amazonaws.com/prod/contact"
VITE_AWS_REGION="us-east-1"
VITE_AWS_DYNAMODB_TABLE="nexora_contact_messages"
